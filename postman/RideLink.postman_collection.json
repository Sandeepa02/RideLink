            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": \"{{passengerAccountId}}\",\n  \"pickupLocation\": {\n    \"address\": \"Colombo Fort Railway Station\",\n    \"latitude\": 6.9344,\n    \"longitude\": 79.8428\n  },\n  \"destinationLocation\": {\n    \"address\": \"Bambalapitiya Junction\",\n    \"latitude\": 6.8910,\n    \"longitude\": 79.8560\n  },\n  \"distanceKm\": 8.5,\n  \"estimatedDurationMinutes\": 22\n}"
