    {
      "name": "4. Fare & Simulated Payment (Workflow 6)",
      "item": [
        {
          "name": "4.1 Calculate Final Fare",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.finalFare).to.be.above(0);",
                  "pm.environment.set(\"finalFare\", jsonData.finalFare);",
                  "console.log(\"Calculated finalFare: \" + jsonData.finalFare);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"distanceKm\": 8.5,\n  \"durationMinutes\": 25\n}"
            },
            "url": {
              "raw": "{{fareServiceUrl}}/api/fares/final",
              "host": ["{{fareServiceUrl}}"],
              "path": ["api", "fares", "final"]
            }
          }
        },
        {
          "name": "4.2 Process Simulated Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                  "pm.expect(jsonData.id).to.not.be.empty;",
                  "pm.environment.set(\"paymentId\", jsonData.id);",
                  "console.log(\"Processed paymentId: \" + jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"fareId\": \"{{fareId}}\",\n  \"amount\": {{finalFare}},\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": {
              "raw": "{{fareServiceUrl}}/api/payments",
              "host": ["{{fareServiceUrl}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "4.3 Get Payment Status",
