              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.status).to.eql(\"REQUESTED\");",
                  "pm.expect(jsonData.id).to.not.be.empty;",
                  "pm.expect(jsonData.fareId).to.not.be.empty;",
                  "pm.environment.set(\"rideId\", jsonData.id);",
                  "pm.environment.set(\"fareId\", jsonData.fareId);",
                  "console.log(\"Saved rideId: \" + jsonData.id + \", fareId: \" + jsonData.fareId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{passengerToken}}"
              }
